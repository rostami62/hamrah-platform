# Supabase — از Project Settings > API در پروژه‌ی Supabase خود کپی کنید.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# فقط سمت سرور استفاده می‌شود؛ هرگز NEXT_PUBLIC_ نگیرد و هرگز به کلاینت ارسال نشود.
# مصرف: عبور از RLS برای عملیات معتبرسازی‌شده مثل تکمیل فرم خوداظهاری با توکن یکبارمصرف.
SUPABASE_SERVICE_ROLE_KEY=

# آدرس عمومی سایت (برای ساخت لینک خوداظهاری پیامکی)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# درگاه پیامک — تا پیش از اتصال یک ارائه‌دهنده‌ی واقعی (کاوه‌نگار/قاصدک/ملی‌پیامک)،
# لینک خوداظهاری فقط در کنسول سرور لاگ می‌شود.
SMS_PROVIDER=console
